          "x": 48,
          "y": 1550,
          "fill": "#64748B",
          "content": "• fadeUp: opacity 0→1 + translateY(100px→0) — 0.8s cubic-bezier(.29,.54,.29,.93)\n• skewDown: opacity 0→1 + skewY(-20°→0) + translateY(-50px→0) — 0.8s\n• tiltX: opacity 0→1 + rotateX(15°→0) — 0.8s perspective flip\n• opacity: simple 0→1 — 0.8s cubic-bezier(.62,-.01,1,1)\n• Stagger delays: 0ms, 200ms, 250ms between grouped elements\n• All animations triggered by IntersectionObserver on scroll",
          "lineHeight": 1.8,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
